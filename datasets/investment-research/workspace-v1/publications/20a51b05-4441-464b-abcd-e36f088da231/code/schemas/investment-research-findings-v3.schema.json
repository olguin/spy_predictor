{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investment-research-findings-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "assessment",
    "claims",
    "gaps",
    "assumptions",
    "counter_thesis",
    "review_conditions",
    "objections",
    "dispositions",
    "question_effects",
    "instruments",
    "role_coverage",
    "shared_exposures"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "assessment": {
      "type": "string",
      "enum": [
        "attractive_candidate",
        "conditional_opportunity",
        "watch",
        "avoid",
        "insufficient_evidence"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "classification",
          "text",
          "evidence_ids",
          "symbols"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "classification": {
            "type": "string",
            "enum": [
              "fact",
              "inference",
              "scenario"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 40
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 5,
            "minItems": 1
          }
        }
      },
      "maxItems": 40
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "critical",
          "symbols"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "critical": {
            "type": "boolean"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 5,
            "minItems": 1
          }
        }
      },
      "maxItems": 12
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "maxItems": 12
    },
    "counter_thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "review_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "description",
          "symbol",
          "operator",
          "threshold_decimal",
          "price_basis",
          "expires_at",
          "evidence_ids"
        ],
        "properties": {
          "kind": {
            "enum": [
              "human_review",
              "completed_close"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "operator": {
            "enum": [
              "above",
              "below",
              null
            ]
          },
          "threshold_decimal": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "price_basis": {
            "enum": [
              "split_adjusted",
              "raw",
              null
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 40
          }
        }
      },
      "maxItems": 10
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objection_id",
          "claim_ids",
          "severity",
          "description",
          "symbols"
        ],
        "properties": {
          "objection_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 40
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "material",
              "minor"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 5,
            "minItems": 1
          }
        }
      },
      "maxItems": 12
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objection_id",
          "decision",
          "reason"
        ],
        "properties": {
          "objection_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "decision": {
            "type": "string",
            "enum": [
              "changed",
              "unchanged",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "maxItems": 200
    },
    "question_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "effect",
          "reason"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effect": {
            "type": "string",
            "enum": [
              "changed",
              "unchanged",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "maxItems": 200
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "assessment",
          "thesis",
          "counter_thesis",
          "assumptions",
          "claim_ids",
          "review_conditions",
          "valuation",
          "etf_lookthrough"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "assessment": {
            "type": "string",
            "enum": [
              "attractive_candidate",
              "conditional_opportunity",
              "watch",
              "avoid",
              "insufficient_evidence"
            ]
          },
          "thesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "counter_thesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1,
            "maxItems": 12
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 40
          },
          "review_conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "description",
                "symbol",
                "operator",
                "threshold_decimal",
                "price_basis",
                "expires_at",
                "evidence_ids"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "human_review",
                    "completed_close"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "operator": {
                  "enum": [
                    "above",
                    "below",
                    null
                  ]
                },
                "threshold_decimal": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]+(\\.[0-9]+)?$"
                },
                "price_basis": {
                  "enum": [
                    "split_adjusted",
                    "raw",
                    null
                  ]
                },
                "expires_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "uniqueItems": true,
                  "maxItems": 40
                }
              }
            },
            "minItems": 1,
            "maxItems": 10
          },
          "valuation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "etf_lookthrough": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "maxItems": 5
    },
    "role_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "status",
          "reason"
        ],
        "properties": {
          "role": {
            "enum": [
              "company",
              "macro",
              "technical",
              "geopolitics",
              "commodities"
            ]
          },
          "status": {
            "enum": [
              "completed",
              "omitted"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "maxItems": 5
    },
    "shared_exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbols",
          "mechanism",
          "evidence_ids",
          "qualification"
        ],
        "properties": {
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 5,
            "minItems": 2
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 40
          },
          "qualification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "maxItems": 12
    }
  }
}
