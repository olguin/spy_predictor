# Local Docker development only. Use a secrets manager outside local development.
SPY_POSTGRES_DB=spy_predictor
SPY_POSTGRES_USER=spy_predictor
SPY_POSTGRES_PASSWORD=spy_predictor_dev
SPY_POSTGRES_PORT=54329
DATABASE_URL=postgresql://spy_predictor:spy_predictor_dev@127.0.0.1:54329/spy_predictor

# Alpaca Market Data API. Generate these in the Alpaca dashboard; never commit
# real values. Historical SIP bars older than 15 minutes are available on the
# free Basic plan.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=sip

# FRED/ALFRED API. Required for complete real-time/vintage macro histories.
FRED_API_KEY=

# Massive Futures Basic ($0/month). Keep the real key only in .env.
MASSIVE_API_KEY=

# IB Gateway paper-trading socket. Authentication happens interactively in IB
# Gateway; never store the IBKR username, password, or MFA response here.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=71
IBKR_MODE=paper
IBKR_READ_ONLY=true
