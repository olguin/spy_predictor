{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spy-predictor.local/schemas/meta-product-view-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "publication_lag_seconds", "mode", "run_status", "probability_status", "as_of", "market_period", "golden_conclusions", "market_summary", "symbols", "freshness", "failures", "alerts", "provenance", "evaluation", "notice", "view_hash"],
  "properties": {
    "schema_version": {"const": "meta-product-view-v3"},
    "generated_at": {"type": "string", "format": "date-time"},
    "publication_lag_seconds": {"type": "number", "minimum": 0},
    "mode": {"enum": ["ON_DEMAND", "PROSPECTIVE"]},
    "run_status": {"enum": ["COMPLETE", "DEGRADED", "BLOCKED"]},
    "probability_status": {"enum": ["UNAVAILABLE", "EXPERIMENTAL_UNCALIBRATED", "PROSPECTIVELY_CALIBRATED"]},
    "as_of": {"type": "string", "format": "date-time"},
    "market_period": {"enum": ["PREMARKET", "REGULAR", "POSTMARKET", "CLOSED"]},
    "golden_conclusions": {"type": "object"},
    "market_summary": {"type": "array", "items": {"type": "object"}},
    "symbols": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "freshness": {"type": "array", "items": {"type": "object", "required": ["family", "scope", "status", "observed_at", "retrieved_at", "coverage", "detail", "age_at_publication_seconds", "criticality", "action_gate"]}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "alerts": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"},
    "evaluation": {"type": ["object", "null"]},
    "notice": {"type": "string"},
    "view_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
