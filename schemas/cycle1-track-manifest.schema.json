{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spy-predictor.local/schemas/cycle1-track-manifest-v1.json",
  "title": "Cycle1TrackManifest",
  "type": "object",
  "required": ["schemaVersion", "trackId", "role", "instrument", "evidenceTier", "preregistrationHash", "sourceAuditHash", "rawResources", "normalizedArtifacts", "coverage", "quality", "resolvedPartitions", "datasetIdentityHash"],
  "properties": {
    "schemaVersion": {"const": "cycle1-track-manifest-v1"},
    "trackId": {"enum": ["discovery-sp500", "validation-spy", "validation-qqq"]},
    "role": {"enum": ["RECONSTRUCTED_DISCOVERY", "ACTUAL_ETF_VALIDATION"]},
    "instrument": {"enum": ["SP500_COMPOSITE", "SPY", "QQQ"]},
    "evidenceTier": {"enum": ["POINT_IN_TIME_ADMISSIBLE", "RECONSTRUCTED_RESEARCH_ONLY"]},
    "preregistrationHash": {"$ref": "#/$defs/hash"},
    "sourceAuditHash": {"$ref": "#/$defs/hash"},
    "rawResources": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 5}},
    "normalizedArtifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "coverage": {"type": "object", "minProperties": 2},
    "quality": {"type": "object", "minProperties": 2},
    "resolvedPartitions": {"type": "object", "minProperties": 1},
    "datasetIdentityHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["kind", "path", "records", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "records": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
