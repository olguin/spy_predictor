{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spy-predictor.local/schemas/meta-pit-observation-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "entity",
    "metric",
    "value",
    "units",
    "source_version",
    "revision_id",
    "source_hash",
    "quality_flags",
    "period_start",
    "period_end",
    "effective_at",
    "published_at",
    "first_seen_at",
    "available_at",
    "captured_at"
  ],
  "properties": {
    "schema_version": {
      "const": "meta-pit-observation-v1"
    },
    "value": {
      "type": "number"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entity": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "first_seen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "available_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "period_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "period_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
