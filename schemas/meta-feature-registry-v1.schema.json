{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spy-predictor.local/schemas/meta-feature-registry-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "meta-feature-registry-v1"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity",
          "name",
          "formula",
          "inputs",
          "input_units",
          "units"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "enum": [
              "LATEST",
              "RATIO",
              "DIFFERENCE"
            ]
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "input_units": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
