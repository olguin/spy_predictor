        "dividendTreatment": "cash-distribution-reinvested-on-ex-date-at-split-adjusted-close"
      },
      "cashReturn": {
        "seriesId": "GS3M",
        "frequency": "monthly",
        "method": "monthly-rolled-simple-accrual-log-return",
        "rateSelection": "latest-observation-month-whose-vintage-was-published-strictly-before-each-monthly-holding-period-start",
        "dayCount": "actual-365",
        "formula": "sum(log(1+(annualPercent/100)*actualDays/365))"
      },
      "inflation": {
        "seriesId": "CPIAUCSL",
        "labelVintage": "latest-vintage-pinned-at-ingestion",
        "method": "log-index-ratio",
        "commonDeflatorRule": "subtract-the-same-log-cpi-change-from-equity-and-cash",
        "excessIdentity": "real-equity-minus-real-cash-equals-nominal-equity-minus-nominal-cash",
        "primaryEligibility": "common-deflator-cancels;CPI-levels-and-publication-do-not-gate-primary-excess-label;separate-real-leg-diagnostics-may-be-unavailable"
      }
    },
    "secondary": {
      "id": "forward-maximum-drawdown-12m",
      "horizonMonths": 12,
      "promotionEligible": false,
      "pathFrequency": "daily-session-close",
      "pathStart": "snapshot-session-total-return-close",
      "pathEnd": "primary-target-endpoint-inclusive",
      "runningPeakIncludesStart": true,
      "formula": "min(level/maximum(levels-from-start-through-current)-1)",
      "eventOperator": "<=",
      "eventThreshold": -0.2
    },
    "diagnostic": {
      "id": "forward-real-excess-total-return-24m",
      "horizonMonths": 24,
      "promotionEligible": false,
      "formula": "primary-target-formula-with-24-month-endpoint",
      "mayRescuePrimaryFailure": false
    },
    "endpointFallback": "use-final-scheduled-session-of-target-calendar-month",
    "labelAvailabilityRule": "primary-path-and-endpoint-availability;strictly-before-training-cutoff;CPI-release-does-not-delay-cancelled-excess-label"
  },
  "features": {
