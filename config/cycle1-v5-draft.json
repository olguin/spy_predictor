  "status": "proposed-synthetic-only",
  "amendment": {
    "supersedesSchemaVersion": "cycle1-preregistration-v4",
    "reason": "Pre-output amendment: GS3M cash proxy, SPY development and QQQ transfer, five stronger comparators, two composite cycle claims, fixed partitions, separate forecast/downside/policy decisions, and mandatory whole-procedure synthetic power evidence.",
    "changedFields": [
      "targets.primary.cashReturn",
      "instrumentRoles",
      "models",
      "partitions",
      "evaluationContract",
      "promotionGates",
      "hypothesisBudget",
