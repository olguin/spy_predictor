    "concentration": {
      "blockLengthMonths": 12,
      "alignment": "start-at-first-evaluated-forecast-in-each-partition-and-mode",
      "benefit": "sum-of-positive-paired-crps-improvements-by-block",
      "zeroTotalBenefitRule": "qualification-fails"
    },
    "economicPolicy": {
      "rebalanceFrequency": "monthly",
      "execution": "next-scheduled-session-open",
      "holdingReturn": "next-execution-open-to-following-execution-open-total-return-with-cash-distributions",
      "weightDrift": "weights-drift-with-equity-and-cash-returns-between-rebalances",
      "riskAdjustedMetric": "annualized-mean-monthly-excess-return-divided-by-annualized-monthly-volatility",
