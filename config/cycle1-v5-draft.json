      "targets.primary.inflation.primaryEligibility",
      "targets.labelAvailabilityRule",
      "partitions.fixedCalendarCounts",
      "evaluationContract.scoreOrdering"
    ],
    "unchangedFields": "12/24-month horizons, equity and drawdown formulas, feature set and signs, deterministic states, ridge/logistic penalties, fixed confirmation dates, no-HMM and no-paid-data rules; bootstrap seed 42 retained; simulation streams require separate preregistration",
    "candidateOutputExistedBeforeAmendment": false,
    "confirmationOutputOpenedBeforeAmendment": false
  },
  "attribution": {
    "modelDescription": "Independent quantitative cycle-asymmetry formalization inspired by public cycle-investing concepts.",
    "proprietaryModelClaimed": false
  },
  "instruments": [
    "SPY",
    "QQQ"
  ],
  "decisionFrequency": {
