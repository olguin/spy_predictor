      "CRISIS": "cheap-and-high-stress-and-weak-direction",
      "CORRECTION": "currently-or-formerly-expensive-and-direction-weak-or-stress-rising",
      "GREED": "expensive-and-positive-direction",
      "NORMAL": "fallback"
