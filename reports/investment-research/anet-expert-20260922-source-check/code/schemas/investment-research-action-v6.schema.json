            "source_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Registered source ID. SEC companyfacts expose normalized numeric financial fields; read matching submissions first if not seeded. Seeded market/ETF/macro sources are already visible and cached."
            }
          }
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
