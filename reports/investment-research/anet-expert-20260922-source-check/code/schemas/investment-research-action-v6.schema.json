            "evidence_id"
          ],
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Literal phrase to locate in complete archived document, including beyond the opening excerpt."
            },
            "occurrence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "Zero-based match; skip contents-table mentions to inspect substantive text."
            }
          }
        }
      },
      "required": [
        "tool",
        "arguments"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
