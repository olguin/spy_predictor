              "type": "string",
              "minLength": 1,
              "maxLength": 12000,
              "description": "Evidence-backed operating thesis plus material specialist causal mechanism; preserve supported observations and conditional conclusions instead of repeating only headlines or missing-input lists."
            },
            "counter_thesis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000,
              "description": "Specific competing transmission mechanism supported or clearly hypothetical, including material specialist findings. Do not infer fund scenario asymmetry or comparative operating demand when no comparable fund measure exists."
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
