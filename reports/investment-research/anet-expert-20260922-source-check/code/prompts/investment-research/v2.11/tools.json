{
  "discover_sources": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "read_source": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "source_id"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Registered source ID. SEC companyfacts expose normalized numeric financial fields; read matching submissions first if not seeded. Seeded market/ETF/macro sources are already visible and cached."
      }
    }
  },
  "inspect_evidence": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "evidence_id"
    ],
    "properties": {
      "evidence_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Literal search in archived document text only. Omit for normalized JSON, scenario grids, panels and prices; visible numeric fields need no repeat inspection."
      },
      "occurrence": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000,
        "description": "Zero-based match; skip contents-table mentions to inspect substantive text."
      }
    }
  },
  "calculate": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation",
      "left",
      "right",
      "units",
      "assumptions",
      "evidence_ids"
    ],
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "percentage_change",
          "valuation_multiple",
          "scenario_price"
        ],
        "description": "scenario_price multiplies left earnings/share assumption by right P/E assumption. Repeat for bear/base/bull and compare each target with an observed price using percentage_change. All scenario assumptions must be explicit."
      },
      "left": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "description": "Exact decimal scenario value OR evidence_id#/JSON/pointer/to/numeric/value. Evidence field references are resolved by Python."
      },
      "right": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "description": "Exact decimal scenario value OR evidence_id#/JSON/pointer/to/numeric/value. Evidence field references are resolved by Python."
      },
      "units": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "assumptions": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "evidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "uniqueItems": true,
        "maxItems": 40
      }
    }
  },
  "ask_specialist": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "recipient",
      "question",
      "decision_impact",
      "evidence_ids",
      "symbols"
    ],
    "properties": {
      "recipient": {
        "type": "string",
        "enum": [
          "company",
          "macro",
          "technical",
          "geopolitics",
          "commodities"
        ]
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "decision_impact": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "evidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "uniqueItems": true,
        "maxItems": 40
      },
      "symbols": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "uniqueItems": true,
        "maxItems": 5,
        "minItems": 1
      }
    }
  },
  "submit_findings": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "summary",
      "assessment",
      "claims",
      "gaps",
      "assumptions",
      "counter_thesis",
      "review_conditions",
      "objections",
      "dispositions",
      "question_effects",
      "instruments",
      "role_coverage",
      "shared_exposures"
    ],
    "properties": {
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "assessment": {
        "type": "string",
        "enum": [
          "attractive_candidate",
          "conditional_opportunity",
          "watch",
          "avoid",
          "insufficient_evidence"
        ]
      },
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_id",
            "classification",
            "text",
            "evidence_ids",
            "symbols",
            "dimensions"
          ],
          "properties": {
            "claim_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "classification": {
              "type": "string",
              "enum": [
                "fact",
                "inference",
                "scenario"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true,
              "maxItems": 40
            },
            "symbols": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true,
              "maxItems": 5,
              "minItems": 1
            },
            "dimensions": {
              "type": "array",
              "items": {
                "enum": [
                  "business",
                  "valuation",
                  "market_behavior",
                  "policy_exposure",
                  "relative_preference"
                ]
              },
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true
            }
          }
        },
        "maxItems": 40
      },
      "gaps": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "critical",
            "symbols",
            "dimensions"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "critical": {
              "type": "boolean",
              "description": "Blocking flag: true forces insufficient_evidence for every listed dimension. False for missing empirical/optional inputs when explicitly conditional analysis remains valid. True only for a concrete unresolved defect/dependency that invalidates that dimension even conditionally. Not a synonym for important."
            },
            "symbols": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true,
              "maxItems": 5,
              "minItems": 1
            },
            "dimensions": {
              "type": "array",
              "items": {
                "enum": [
                  "business",
                  "valuation",
                  "market_behavior",
                  "policy_exposure",
                  "relative_preference"
                ]
              },
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "description": "Only dimensions actually blocked or limited by this specific gap; distinguish unsupported current/quantified claims from valid conditional analysis. Do not propagate an unrelated role limitation."
            }
          }
        },
        "maxItems": 12
      },
      "assumptions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "maxItems": 12
      },
      "counter_thesis": {
        "type": "string",
        "minLength": 1,
        "maxLength": 12000
      },
      "review_conditions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description",
            "symbol",
            "operator",
            "threshold_decimal",
            "price_basis",
            "expires_at",
            "evidence_ids"
          ],
          "properties": {
            "kind": {
              "enum": [
                "human_review",
                "completed_close"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            },
            "operator": {
              "enum": [
                "above",
                "below",
                null
              ]
            },
            "threshold_decimal": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            "price_basis": {
              "enum": [
                "split_adjusted",
                "raw",
                null
              ]
            },
            "expires_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true,
              "maxItems": 40
            }
          }
        },
        "maxItems": 10
      },
      "objections": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objection_id",
            "claim_ids",
            "severity",
            "description",
            "symbols",
            "dimensions"
          ],
          "properties": {
            "objection_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "claim_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true,
              "maxItems": 40
            },
            "severity": {
              "type": "string",
              "enum": [
                "critical",
                "material",
                "minor"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "symbols": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true,
              "maxItems": 5,
              "minItems": 1
            },
            "dimensions": {
              "type": "array",
              "items": {
                "enum": [
                  "business",
                  "valuation",
                  "market_behavior",
                  "policy_exposure",
                  "relative_preference"
                ]
              },
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true
            }
          }
        },
        "maxItems": 12
      },
      "dispositions": {
        "type": "array",
        "items": {
          "type": "object",
