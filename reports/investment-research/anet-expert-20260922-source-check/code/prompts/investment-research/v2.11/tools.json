              "type": "string",
              "enum": [
                "changed",
                "unchanged",
                "unresolved"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
